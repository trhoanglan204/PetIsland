@{
    ViewData["Title"] = "QR Scanner";
}

<h2>Upload QR Code Image</h2>

<form method="post" enctype="multipart/form-data">

    <div>
        <label>QR Image:</label><br />
        <input type="file" name="file" accept="image/*" required />
    </div>

    <br />

    <div>
        <label>Ed25519 Public Key (Base64):</label><br />
        <textarea name="publicKey" rows="3" cols="80" required></textarea>
    </div>

    <br />

    <button type="submit">Scan & Verify</button>
</form>

@if (ViewBag.Result != null)
{
    <hr />
    <p><strong>@ViewBag.Result</strong></p>
}
